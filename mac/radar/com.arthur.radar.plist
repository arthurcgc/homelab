<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.arthur.radar</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/kubectl-radar</string>
    <string>--no-browser</string>
    <string>--listen-address=127.0.0.1</string>
    <string>--port=9280</string>
    <string>--base-path=/radar</string>
    <string>--trusted-origins=http://localhost,http://localhost:80,http://127.0.0.1,http://127.0.0.1:80</string>
    <string>--timeline-storage=sqlite</string>
    <string>--timeline-db=__HOME__/.radar/timeline.db</string>
    <string>--timeline-retention=168h</string>
    <string>--timeline-max-size=1Gi</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:__HOME__/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>HOME</key><string>__HOME__</string>
    <key>RADAR_AI_CLI_BIN</key><string>__HOME__/.radar/bin/codex-fast</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/radar.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/radar-error.log</string>
</dict>
</plist>
